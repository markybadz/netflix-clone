<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180dp home-screen banner shown by the Android TV / Google TV launcher. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/black" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item
        android:bottom="66dp"
        android:left="40dp"
        android:right="40dp"
        android:top="66dp"
        android:drawable="@drawable/ic_netflix_logo" />
</layer-list>
